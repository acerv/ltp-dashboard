# VHS demo — https://github.com/charmbracelet/vhs
# Run: vhs demo.tape

Output demo.gif

Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 700
Set Padding 10
Set TypingSpeed 100ms

Hide
Type "cargo build --release --quiet"
Enter
Sleep 5s
Type "clear"
Enter
Show

Type "./target/release/ltp-dashboard --max 50 | less -R"
Enter
Sleep 10s

# Scroll down smoothly using less
Sleep 1s
Type "j"
Sleep 0.3s
